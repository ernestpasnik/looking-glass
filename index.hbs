<!doctype html>
<html lang="en" data-bs-theme="{{themeMode}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Looking Glass — {{company}}</title>

  <!-- Bootswatch CDN -->
  <link 
    href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/{{bootswatchTheme}}/bootstrap.min.css" 
    rel="stylesheet">
</head>
<body class="bg-body-tertiary">

  <div class="container col-lg-8 mx-auto p-3 py-md-5">

    <!-- Header -->
    <header class="d-flex justify-content-between align-items-center mb-5">
      <a class="navbar-brand" href="{{companyUrl}}">
        <h1 class="h3 m-0">{{company}}</h1>
      </a>
      <select id="locations" class="form-select w-auto" onchange="window.location = this.value">
        {{#each locations}}
          <option value="{{this}}" {{#if (eq @key ../location)}}selected{{/if}}>{{@key}}</option>
        {{/each}}
      </select>
    </header>

    <!-- Main Card -->
    <main class="mb-5">
      <div class="card shadow-lg">

        <!-- Looking Glass Info -->
        <section class="card-body border-bottom">
          <h2 class="fs-5 mb-3">Looking Glass</h2>
          <div class="row g-3">

            <!-- Location -->
            <div class="col-md-6">
              <label for="loc" class="form-label text-muted">Location</label>
              <div class="input-group">
                <input id="loc" class="form-control" value="{{location}}" readonly onfocus="this.select()">
                <a class="btn btn-outline-primary" href="{{locationUrl}}" target="_blank">Map</a>
              </div>
            </div>

            <!-- Facility -->
            <div class="col-md-6">
              <label for="fac" class="form-label text-muted">Facility</label>
              <div class="input-group">
                <input id="fac" class="form-control" value="{{facility}}" readonly onfocus="this.select()">
                <a class="btn btn-outline-primary" href="{{facilityUrl}}" target="_blank">PeeringDB</a>
              </div>
            </div>

            <!-- IPv4 -->
            <div class="col-md-6">
              <label for="v4" class="form-label text-muted">IPv4</label>
              <div class="input-group">
                <input id="v4" class="form-control" value="{{ipv4}}" readonly onfocus="this.select()">
                <button class="btn btn-outline-primary" onclick="copy('{{ipv4}}', this)">Copy</button>
              </div>
            </div>

            <!-- IPv6 -->
            <div class="col-md-6">
              <label for="v6" class="form-label text-muted">IPv6</label>
              <div class="input-group">
                <input id="v6" class="form-control" value="{{ipv6}}" readonly onfocus="this.select()">
                <button class="btn btn-outline-primary" onclick="copy('{{ipv6}}', this)">Copy</button>
              </div>
            </div>

          </div>
        </section>

        <!-- Command Query -->
        <section class="card-body border-bottom">
          <h2 class="fs-5 mb-3">Command Query</h2>
          <div class="row g-3">

            <div class="col-md-6">
              <label for="target" class="form-label text-muted">Target</label>
              <input id="target" type="text" class="form-control" placeholder="IP or hostname">
            </div>

            <div class="col-md-6">
              <label class="form-label text-muted mb-2">Execute</label>
              <div class="btn-group w-100">
                <button id="ping" class="btn btn-outline-primary" onclick="send('ping')">ping</button>
                <button id="mtr" class="btn btn-outline-primary" onclick="send('mtr')">mtr</button>
                <button id="traceroute" class="btn btn-outline-primary" onclick="send('traceroute')">traceroute</button>
              </div>
            </div>

            <div class="col-12">
              <pre id="output" class="p-3 bg-dark text-light rounded d-none"></pre>
            </div>

          </div>
        </section>

        <!-- Speed Test -->
        <section class="card-body">
          <h2 class="fs-5 mb-3">Speed Test</h2>
          <div class="row g-3">

            <div class="col-md-6">
              <label for="inc" class="form-label text-muted">iPerf3 Incoming</label>
              <div class="input-group">
                <input id="inc" class="form-control" value="{{iPerf3incoming}}" readonly onfocus="this.select()">
                <button class="btn btn-outline-primary" onclick="copy('{{iPerf3incoming}}', this)">Copy</button>
              </div>
            </div>

            <div class="col-md-6">
              <label for="out" class="form-label text-muted">iPerf3 Outgoing</label>
              <div class="input-group">
                <input id="out" class="form-control" value="{{iPerf3outgoing}}" readonly onfocus="this.select()">
                <button class="btn btn-outline-primary" onclick="copy('{{iPerf3outgoing}}', this)">Copy</button>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label text-muted mb-2">Test Files</label>
              <div class="btn-group w-100">
                {{#each speedtestFiles}}
                  <a href="{{this}}" class="btn btn-outline-primary">{{@key}}</a>
                {{/each}}
              </div>
            </div>

          </div>
        </section>

      </div>
    </main>

    <!-- Footer -->
    <footer class="d-flex justify-content-between align-items-center mt-4">
      <small class="text-muted">
        Looking Glass licensed 
        <a href="https://github.com/ernestpasnik/looking-glass/blob/main/LICENSE" target="_blank">Apache-2.0</a>.
      </small>
      <a href="https://github.com/ernestpasnik/looking-glass" target="_blank">
        <img src="https://img.shields.io/github/stars/ernestpasnik/looking-glass" alt="GitHub">
      </a>
    </footer>

  </div>

  <script src="client.js"></script>
  <script>
    async function copy(text, btn) {
      if (!navigator.clipboard?.writeText) return;
      btn.textContent = 'Copied';
      await navigator.clipboard.writeText(text);
      setTimeout(() => btn.textContent = 'Copy', 1000);
    }
  </script>
</body>
</html>